# Local developer setup (do not put secrets in Git)
DATABASE_URL=sqlite:///./green_commute.db
JWT_SECRET=
# Demo data requires this flag in a non-production environment.
SEED_DEMO_DATA=0
# DEMO_PASSWORD=
# Production: DATABASE_URL=mysql+pymysql://user:password@host:3306/green_commute?charset=utf8mb4
MYSQL_ROOT_PASSWORD=replace-root-db-password
MYSQL_PASSWORD=replace-app-db-password

# Optional passwordless email login. console prints the six-digit code for local demos.
EMAIL_DELIVERY=console
# EMAIL_DELIVERY=smtp
# SMTP_HOST=smtp.example.com
# SMTP_PORT=465
# SMTP_USE_SSL=1
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=
# QQ 邮箱示例：SMTP_HOST=smtp.qq.com，SMTP_USERNAME/SMTP_FROM 填完整QQ邮箱，SMTP_PASSWORD 填邮箱授权码（不是QQ登录密码）。

# OPTIONAL: Real LLM provider, used only on the server. Do not commit actual keys.
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=https://api.deepseek.com
# For a locally running OpenAI-compatible model (localhost ONLY), allow no key:
# AI_LOCAL_NO_KEY=1
