# Local developer setup (do not put secrets in Git)
DATABASE_URL=sqlite:///./green_commute.db
JWT_SECRET=replace-with-64-random-characters
DEMO_PASSWORD=Demo@123456
# Production: DATABASE_URL=mysql+pymysql://user:password@host:3306/green_commute?charset=utf8mb4
MYSQL_ROOT_PASSWORD=replace-root-db-password
MYSQL_PASSWORD=replace-app-db-password

# OPTIONAL: Real LLM provider, used only on the server. Do not commit actual keys.
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=https://api.deepseek.com
# For a locally running OpenAI-compatible model (localhost ONLY), allow no key:
# AI_LOCAL_NO_KEY=1
